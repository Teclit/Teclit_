# Copier en `.env` (jamais commité) — lu par `npm run serve:ssr` et docker compose.

# --- Serveur SSR ---
PORT=4000
# URL publique : canonical / Open Graph / sitemap au build, et hôte autorisé par le serveur SSR.
SITE_URL=
# Hôtes supplémentaires autorisés pour le rendu SSR (séparés par des virgules).
NG_ALLOWED_HOSTS=
# Nombre de proxys de confiance devant le serveur (1 derrière un reverse proxy / load balancer).
TRUST_PROXY=0

# --- Formulaire de contact (Resend : https://resend.com) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Expéditeur vérifié dans Resend, ex. "Portfolio <contact@mon-domaine.fr>"
CONTACT_FROM_EMAIL=
