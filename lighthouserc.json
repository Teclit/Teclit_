{
  "ci": {
    "collect": {
      "startServerCommand": "node dist/teclit/server/server.mjs",
      "startServerReadyPattern": "écoute",
      "url": ["http://localhost:4000/", "http://localhost:4000/cv", "http://localhost:4000/projets/qcmplus"],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--headless=new --no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200, "aggregationMethod": "median-run" }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
